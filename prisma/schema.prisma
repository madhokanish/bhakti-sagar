generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String?                 @unique
  // E.164, e.g. "+919876543210". Set for accounts created by phone OTP, null for Google
  // accounts. Phone and Google sign-ins are deliberately separate accounts: there is no
  // linking, so a person using both ends up with two, which is the accepted trade.
  phone                  String?                 @unique
  phoneVerified          DateTime?
  name                   String?
  image                  String?
  emailVerified          DateTime?
  stripeCustomerId       String?                 @unique
  razorpayCustomerId     String?                 @unique
  razorpaySubscriptionId String?                 @unique
  subscriptionStatus     String                  @default("inactive")
  currency               String                  @default("GBP")
  trialEnd               DateTime?
  currentPeriodEnd       DateTime?
  /// Set when the member asks to cancel but keeps access to the end of the period they
  /// already paid for. Until that period elapses their status stays "active", so without
  /// this marker a cancelled membership is indistinguishable from a renewing one — both
  /// here and in the app. Cleared when a new subscription starts.
  cancellationRequestedAt DateTime?
  reminder3DaySentAt     DateTime?
  reminder1DaySentAt     DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  isReviewer             Boolean                 @default(false)
  accounts               Account[]
  sessions               Session[]
  mobileSessions         MobileSession[]
  webCheckoutHandoffs    WebCheckoutHandoff[]
  razorpayAutopayMandates RazorpayAutopayMandate[]
  authEvents             AuthEvent[]
  profile                UserProfile?
  bhaktiGptConversations BhaktiGptConversation[]
  bhaktiGptUsage         BhaktiGptUsage?
  subscriptionStatusChanges SubscriptionStatusChange[]
}

/// A UPI AutoPay mandate created through Razorpay's direct recurring-payments API.
/// This is intentionally independent from the older Razorpay Subscription checkout rail:
/// the direct API returns a `upi://mandate` link that Android opens in the customer's own
/// UPI app.
model RazorpayAutopayMandate {
  id                   String                  @id @default(cuid())
  userId               String
  razorpayCustomerId   String
  customerContact      String
  razorpayOrderId      String                  @unique
  razorpayPaymentId    String                  @unique
  razorpayTokenId      String?                 @unique
  status               String                  @default("pending")
  authorizationAmount  Int
  billingAmount        Int
  currency             String                  @default("INR")
  frequency            String                  @default("monthly")
  nextBillingAt        DateTime?
  expiresAt            DateTime
  approvedAt           DateTime?
  cancellationRequestedAt DateTime?
  lastCheckedAt        DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  charges              RazorpayAutopayCharge[]

  @@index([userId, status])
  @@index([status, nextBillingAt])
}

/// Each post-mandate debit is stored independently, making cron retries idempotent and
/// ensuring a payment id can never be associated with two billing periods.
model RazorpayAutopayCharge {
  id                 String                  @id @default(cuid())
  mandateId          String
  razorpayOrderId    String                  @unique
  razorpayPaymentId  String?                 @unique
  amount             Int
  status             String                  @default("created")
  scheduledFor       DateTime
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  mandate            RazorpayAutopayMandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@unique([mandateId, scheduledFor])
  @@index([status, scheduledFor])
}

/// Append-only log of every membership status transition. The User row only ever holds the
/// current status, so without this there is no way to see that someone was pro and later
/// lapsed. Written by `setUserSubscriptionStatus` in src/lib/subscriptionStatus.ts, which is
/// the single chokepoint every status write funnels through.
model SubscriptionStatusChange {
  id         String   @id @default(cuid())
  userId     String
  fromStatus String
  toStatus   String
  /// Which code path made the change, e.g. "stripe-webhook", "razorpay-webhook",
  /// "upi-autopay-cancel". Lets a suspicious transition be traced back to its origin.
  source     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  createdAt     DateTime @default(now())
}

model RazorpayWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, short-lived token for handing an already-authenticated mobile-app
/// user off to a Custom Tab as a real signed-in web session -- the app can't set
/// a cookie in Chrome's separate cookie jar, so this is passed in the URL instead
/// and exchanged for a session cookie server-side by /api/checkout-handoff.
model WebCheckoutHandoff {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MobileSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model MobileAuthChallenge {
  id         String    @id @default(cuid())
  nonceHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt, consumedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  displayName          String?
  country              String?
  locale               String?
  onboardingCompleted  Boolean  @default(false)
  subscriptionStatus   String   @default("none")
  subscriptionPlan     String?
  subscriptionProvider String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BhaktiGptConversation {
  id                   String             @id @default(cuid())
  userId               String?
  sessionId            String?
  guideId              String
  title                String?
  conversationMetadata Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages             BhaktiGptMessage[]

  @@index([userId, guideId, updatedAt])
  @@index([sessionId, guideId, updatedAt])
  @@index([guideId, updatedAt])
}

model BhaktiGptMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           BhaktiGptMessageRole
  content        String
  createdAt      DateTime              @default(now())
  conversation   BhaktiGptConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model BhaktiGptUsage {
  id           String   @id @default(cuid())
  userId       String?  @unique
  sessionId    String?  @unique
  messageCount Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  eventType String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

enum BhaktiGptMessageRole {
  user
  assistant
  system
}
