# Core app
APP_URL=
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Google Analytics (BhaktiChat.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-9H0MCC74YW
# Optional on Vercel. If NEXTAUTH_URL is missing, auth derives from https://$VERCEL_URL.
VERCEL_URL=
SESSION_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_BHAKTIGPT=
OPENAI_MODEL_BHAKTIGPT_FAST=
OPENAI_MODEL_BHAKTIGPT_STRONG=

# OAuth + magic-link auth (Auth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native Android uses the same Web OAuth client ID as GOOGLE_CLIENT_ID when requesting
# server-verifiable ID tokens through Credential Manager.
ANDROID_GOOGLE_WEB_CLIENT_ID=

# Google Play review access. Use a long random access key and enter the same credentials
# in Play Console > App content > Sign-in details. This account is isolated from real users.
PLAY_REVIEW_USERNAME=
PLAY_REVIEW_ACCESS_KEY=
PLAY_REVIEW_EMAIL=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Keep literal newlines or escaped \n.
APPLE_PRIVATE_KEY=
# Optional override if you pre-generated it.
APPLE_CLIENT_SECRET=
# Backward-compatible alias for APPLE_CLIENT_ID.
APPLE_ID=

# Email magic links (Resend)
# Optional for local dev (magic link URL logs to server console).
# Required in production for real email delivery.
RESEND_API_KEY=
EMAIL_FROM="Bhakti Chat <no-reply@yourdomain.com>"
# Backward-compatible fallback used by existing email utilities.
RESEND_FROM_EMAIL=

# Optional Redis-backed auth rate limiting (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# YouTube + content
YT_API_KEY=

# Stripe / subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_GANESH_MONTHLY=
STRIPE_PRICE_ID_SHANI_MONTHLY=
STRIPE_PRICE_ID_GANESH_ONCE=
STRIPE_PRICE_ID_SHANI_ONCE=

# Online Puja notifications (legacy routes, if enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ONLINE_PUJA_RECIPIENT_EMAIL=

# Optional header auth for cron endpoint
CRON_SECRET=
